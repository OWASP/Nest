ARG OWASP_GID=1000
ARG OWASP_UID=1000

# CrewAI's native dependencies publish glibc wheels, not Alpine/musl wheels.
FROM python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26 AS builder

ARG OWASP_GID
ARG OWASP_UID

ENV PIP_CACHE_DIR="/home/owasp/.cache/pip" \
    POETRY_CACHE_DIR="/home/owasp/.cache/pypoetry" \
    PYTHONUNBUFFERED=1

RUN groupadd -g "${OWASP_GID}" owasp && \
    useradd -l -m -u "${OWASP_UID}" -g owasp owasp && \
    mkdir -p "${POETRY_CACHE_DIR}" && \
    chown -R owasp:owasp /home/owasp

COPY --chmod=444 --chown=root:root requirements/build.txt /tmp/
RUN --mount=type=cache,target=${PIP_CACHE_DIR} \
    python -m pip install --only-binary :all: --require-hashes --requirement /tmp/build.txt

WORKDIR /home/owasp
USER owasp

COPY --chmod=444 --chown=root:root poetry.lock poetry.toml pyproject.toml ./
RUN --mount=type=cache,target=${POETRY_CACHE_DIR},uid=${OWASP_UID},gid=${OWASP_GID} \
    poetry config installer.only-binary :all: && \
    poetry install --no-root --verbose --only main --only nestbot


FROM python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26

ARG OWASP_GID
ARG OWASP_UID

RUN groupadd -g "${OWASP_GID}" owasp && \
    useradd -l -m -u "${OWASP_UID}" -g owasp owasp

ENV FORCE_COLOR=1 \
    PIP_CACHE_DIR="/home/owasp/.cache/pip" \
    PATH="/home/owasp/.venv/bin:$PATH" \
    PYTHONPATH="/home/owasp/src" \
    PYTHONUNBUFFERED=1

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql-client redis-tools && \
    rm -rf /var/lib/apt/lists/*

COPY --chmod=444 --chown=root:root requirements/build.txt /tmp/
RUN --mount=type=cache,target=${PIP_CACHE_DIR} \
    python -m pip install --only-binary :all: --require-hashes --requirement /tmp/build.txt

EXPOSE 8001

WORKDIR /home/owasp
USER owasp

COPY --from=builder --chmod=555 --chown=root:root /home/owasp /home/owasp
