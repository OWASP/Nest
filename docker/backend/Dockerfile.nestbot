ARG OWASP_GID=1000
ARG OWASP_UID=1000

FROM python:3.13.15-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b AS builder

ARG OWASP_GID
ARG OWASP_UID

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV POETRY_CACHE_DIR="/home/owasp/.cache/pypoetry" \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    PYTHONUNBUFFERED=1

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
        libpq-dev \
        libssl-dev \
        passwd \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g "${OWASP_GID}" owasp \
    && useradd -l -m -u "${OWASP_UID}" -g owasp owasp

COPY requirements/build.txt /tmp/build.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --only-binary :all: --require-hashes --requirement /tmp/build.txt

USER owasp
WORKDIR /home/owasp

COPY --chown=root:root poetry.lock poetry.toml pyproject.toml ./
RUN --mount=type=cache,target=${POETRY_CACHE_DIR},uid=${OWASP_UID},gid=${OWASP_GID} \
    poetry install --no-root --only main,nestbot

FROM python:3.13.15-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b

ARG OWASP_GID
ARG OWASP_UID

ENV PATH="/home/owasp/.venv/bin:$PATH" \
    PYTHONPATH="/home/owasp/src" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        libstdc++6 \
        passwd \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g "${OWASP_GID}" owasp \
    && useradd -l -m -u "${OWASP_UID}" -g owasp owasp

WORKDIR /home/owasp

COPY --from=builder --chown=root:root --chmod=555 /home/owasp/.venv ./.venv
COPY --chown=root:root src ./src
COPY --chown=root:root templates ./templates
COPY --chown=root:root static ./static
COPY --chown=root:root manage.py ./
COPY --chown=root:root --chmod=555 entrypoint.nestbot.sh ./

USER owasp
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["sh", "-c", "wget -q -O /dev/null \"http://$(hostname -i):8000/status/\""]

CMD ["./entrypoint.nestbot.sh"]
