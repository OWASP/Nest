ARG OWASP_GID=1000
ARG OWASP_UID=1000

FROM python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26 AS builder

ARG OWASP_GID
ARG OWASP_UID

ENV PIP_CACHE_DIR="/home/owasp/.cache/pip" \
    POETRY_CACHE_DIR="/home/owasp/.cache/pypoetry" \
    POETRY_INSTALLER_ONLY_BINARY=":all:" \
    PYTHONUNBUFFERED=1

RUN groupadd -g "${OWASP_GID}" owasp && \
    useradd -l -m -u "${OWASP_UID}" -g owasp owasp && \
    mkdir -p "${POETRY_CACHE_DIR}" && \
    chown -R owasp:owasp /home/owasp

COPY --chmod=444 --chown=root:root requirements/build.txt /tmp/
RUN --mount=type=cache,target=${PIP_CACHE_DIR} \
    python -m pip install --only-binary :all: --require-hashes --requirement /tmp/build.txt

WORKDIR /home/owasp
USER owasp

COPY --chmod=444 --chown=root:root poetry.lock poetry.toml pyproject.toml ./
RUN --mount=type=cache,target=${POETRY_CACHE_DIR},uid=${OWASP_UID},gid=${OWASP_GID} \
    poetry export --format requirements.txt --only main,nestbot \
        --output /tmp/nestbot-requirements.txt && \
    python -m venv .venv && \
    .venv/bin/python -m pip install --no-cache-dir --no-deps --only-binary :all: --require-hashes \
        --requirement /tmp/nestbot-requirements.txt

# Package installation is complete; do not ship pip's vendored dependencies.
RUN .venv/bin/python -m pip uninstall --yes pip


FROM python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26

ARG OWASP_GID
ARG OWASP_UID

ENV PATH="/home/owasp/.venv/bin:$PATH" \
    PYTHONPATH="/home/owasp/src" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        apt \
        ca-certificates \
        libpcre2-8-0 \
        libpq5 \
        libssl3 \
        libstdc++6 \
        openssl \
        passwd \
        perl-base \
        tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall --yes pip \
    && groupadd -g "${OWASP_GID}" owasp \
    && useradd -l -m -u "${OWASP_UID}" -g owasp owasp

WORKDIR /home/owasp

COPY --from=builder --chown=root:root --chmod=555 /home/owasp/.venv ./.venv
COPY --chown=root:root src ./src
COPY --chown=root:root templates ./templates
COPY --chown=root:root static ./static
COPY --chown=root:root manage.py ./
COPY --chown=root:root --chmod=555 entrypoint.nestbot.sh ./

USER owasp
EXPOSE 8000

# Probe only loopback without sending credentials or following redirects.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["python", "-c", "from http.client import HTTPConnection; c = HTTPConnection('127.0.0.1', 8000, timeout=5); c.request('GET', '/status/'); r = c.getresponse(); c.close(); raise SystemExit(0 if r.status == 200 else 1)"]

CMD ["./entrypoint.nestbot.sh"]
