ARG OWASP_GID=1000
ARG OWASP_UID=1000

FROM python:3.13.15-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b AS builder

ARG OWASP_GID
ARG OWASP_UID

ENV POETRY_CACHE_DIR="/home/owasp/.cache/pypoetry" \
    PYTHONUNBUFFERED=1

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libffi-dev libpq-dev libssl-dev passwd \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g "${OWASP_GID}" owasp \
    && useradd -l -m -u "${OWASP_UID}" -g owasp owasp

COPY --chmod=444 --chown=root:root requirements/build.txt /tmp/build.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --only-binary :all: --require-hashes --requirement /tmp/build.txt

WORKDIR /home/owasp
USER owasp

COPY --chmod=444 --chown=root:root poetry.lock poetry.toml pyproject.toml ./
RUN --mount=type=cache,target=${POETRY_CACHE_DIR},uid=${OWASP_UID},gid=${OWASP_GID} \
    poetry install --no-root --verbose --only main,test,video,nestbot

COPY manage.py ./
COPY scripts scripts
COPY static static
COPY templates templates
COPY src src
COPY tests/unit tests/unit

FROM python:3.13.15-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b

ARG OWASP_GID
ARG OWASP_UID

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 libstdc++6 passwd \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g "${OWASP_GID}" owasp \
    && useradd -l -m -u "${OWASP_UID}" -g owasp owasp

ENV FORCE_COLOR=1 \
    PATH="/home/owasp/.venv/bin:$PATH" \
    PYTHONPATH="/home/owasp/src" \
    PYTHONUNBUFFERED=1

WORKDIR /home/owasp
USER owasp

COPY --from=builder --chmod=555 --chown=root:root /home/owasp /home/owasp
